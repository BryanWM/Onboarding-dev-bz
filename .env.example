# ==============================================================================
# CONFIGURACOES SUPABASE - WRMAX ONBOARDING
# Copie para .env (local) e cadastre as mesmas variaveis na Vercel/Lovable.
# Sem VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY o app so roda em modo demo
# (apenas em `npm run dev`); um build de producao sem elas fica fechado.
# ==============================================================================

# URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publica anonima (anon / public key) - vai para o navegador
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave service_role - SOMENTE SERVIDOR. Nunca use prefixo VITE_ nesta chave.
# Usada por src/lib/arquivos-cliente.ts para validar o token do cliente e gerar
# URLs assinadas dos buckets privados (apresentacao, contrato, comprovante).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
